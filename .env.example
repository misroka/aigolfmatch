# Environment Configuration

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=golf_clubs
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSLMODE=require  # Required for Azure PostgreSQL, remove for local

# Web Application Security
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Flask Settings
FLASK_DEBUG=False
APP_ENV=development
# Set APP_ENV=production behind HTTPS; requires a persistent secret and admin hash.
# Only load locally trained JSON artifacts; never accept a model path from clients.
RECOMMENDER_MODEL_PATH=artifacts/recommender.json

# Web Scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
REQUEST_DELAY=2
MAX_RETRIES=3

# API Keys (if needed)
# GOLF_API_KEY=your_api_key_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/golf_scraper.log
